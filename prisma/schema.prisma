generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  GUEST
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum MovementType {
  INCOMING
  OUTGOING
  ADJUSTMENT
}

model User {
  id                String             @id @default(cuid())
  telegramId        String             @unique
  username          String?
  firstName         String?
  lastName          String?
  photoUrl          String?
  role              Role               @default(GUEST)
  isActive          Boolean            @default(true)
  authDate          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  ordersCreated     Order[]            @relation("OrderCreatedBy")
  ordersUpdated     Order[]            @relation("OrderUpdatedBy")
  incomingsCreated  Incoming[]         @relation("IncomingCreatedBy")
  incomingsUpdated  Incoming[]         @relation("IncomingUpdatedBy")
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]

  @@index([telegramId])
  @@index([role])
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  nomenclatures  Nomenclature[]
  orders         Order[]
  incomings      Incoming[]
  stockMovements StockMovement[]
}

model Group {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  nomenclatures Nomenclature[]
}

model Nomenclature {
  id             String          @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  article        String
  barcode        String?
  title          String
  shortTitle     String?
  groupId        String
  group          Group           @relation(fields: [groupId], references: [id])
  quantity       Decimal         @default(0)
  price          Decimal         @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orderItems     OrderItem[]
  incomingItems  IncomingItem[]
  stockMovements StockMovement[]

  @@unique([warehouseId, barcode])
  @@index([warehouseId])
  @@index([barcode])
  @@index([article])
  @@index([groupId])
}

model StockMovement {
  id           String       @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  product      Nomenclature @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Decimal
  documentType String?
  documentId   String?
  comment      String?
  createdById  String?
  createdAt    DateTime     @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  inn       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([name])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  inn       String?
  phone     String?
  email     String?
  comments  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  incomings Incoming[]

  @@index([name])
}

model Order {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  number      String
  status      DocumentStatus @default(DRAFT)
  comment     String?
  totalAmount Decimal        @default(0)
  createdById String?
  createdBy   User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?          @relation("OrderUpdatedBy", fields: [updatedById], references: [id])
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       OrderItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([clientId])
  @@index([createdAt])
}

model OrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Nomenclature @relation(fields: [productId], references: [id])
  quantity  Decimal
  price     Decimal
  total     Decimal

  @@index([orderId])
  @@index([productId])
}

model Incoming {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  number      String
  status      DocumentStatus @default(DRAFT)
  comment     String?
  totalAmount Decimal        @default(0)
  createdById String?
  createdBy   User?          @relation("IncomingCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?          @relation("IncomingUpdatedBy", fields: [updatedById], references: [id])
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       IncomingItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
}

model IncomingItem {
  id            String       @id @default(cuid())
  incomingId    String
  incoming      Incoming     @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  productId     String
  product       Nomenclature @relation(fields: [productId], references: [id])
  quantity      Decimal
  purchasePrice Decimal
  total         Decimal

  @@index([incomingId])
  @@index([productId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
